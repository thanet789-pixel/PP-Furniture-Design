rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Services Collection: Anyone can view, only authenticated admins can write
    match /services/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Portfolio Collection: Anyone can view, only authenticated admins can write
    match /portfolio/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Team Members Collection: Anyone can view, only authenticated admins can write
    match /teamMembers/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Contact Messages Collection: Anyone can submit a message (create), only authenticated admins can read, update, or delete
    match /contactMessages/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
